{
  "name": "murugan-lab-website",
  "version": "1.0.0",
  "description": "Static website for the Murugan Lab at University of Chicago",
  "main": "local-server.js",
  "scripts": {
    "test": "mkdir -p tests/results && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=tap --test-reporter-destination=tests/results/test_update_website.tap tests/test_*.js",
    "start": "node local-server.js",
    "update": "python ../murugan_cv/code_compile_cv/fetch_sheet.py --out data/website_data.xlsx && node scripts/update_website.js",
    "update:offline": "node scripts/update_website.js"
  },
  "keywords": [
    "website",
    "static",
    "academic"
  ],
  "author": "Arvind Murugan",
  "license": "MIT",
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
